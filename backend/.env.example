# Environment Configuration
NODE_ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=norma3100
DB_USER=postgres
DB_PASSWORD=postgres_dev_password

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_REFRESH_EXPIRATION=7d
# Ventana temporal de migración (ISO date). Mientras esté definida y no haya
# vencido, validateToken() acepta refresh tokens firmados con el JWT_SECRET
# antiguo (previos a separar los secretos). Quitar esta variable una vez
# vencido el máximo lifetime de refresh tokens (14 días) tras el despliegue
# que introdujo JWT_REFRESH_SECRET — dejarla indefinida es la postura segura.
# JWT_REFRESH_GRACE_UNTIL=2026-07-21T00:00:00.000Z

# Application Configuration
PORT=3001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@norma3100.com

# Verificación de firmas de webhooks (fail-closed en producción)
MAILGUN_WEBHOOK_SIGNING_KEY=
TWILIO_AUTH_TOKEN=
SENDGRID_WEBHOOK_SECRET=
AWS_SNS_WEBHOOK_SECRET=
FCM_WEBHOOK_SECRET=
APNS_WEBHOOK_SECRET=

# External APIs (REPS/INVIMA)
REPS_API_BASE_URL=https://api.reps.gov.co
REPS_API_KEY=
INVIMA_API_BASE_URL=https://api.invima.gov.co
INVIMA_API_KEY=

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=dev_session_secret_change_in_production
SESSION_TTL=86400
DISABLE_RATE_LIMIT=false

# AES-256 Encryption at Rest (Phase 6.1.2)
# Genera una clave con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUERIDA en producción — en desarrollo se usa una clave derivada automáticamente
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# Habilita cifrado AES-256-GCM de payloads en event store
ENCRYPT_EVENT_PAYLOADS=false

# Backup Configuration
# Passphrase para cifrar backups con AES-256-CBC
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Feature Flags
ENABLE_MFA=false
ENABLE_EXTERNAL_SYNC=false
