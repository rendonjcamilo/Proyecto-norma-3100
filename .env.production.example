# .env.production.example — Variables de entorno para producción
# Copiar a .env.production en el VPS y completar los valores reales:
#   cp .env.production.example .env.production
#   nano .env.production
#
# NUNCA subir .env.production al repositorio.

# ── Base de Datos ──────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=norma3100
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_FUERTE_MINIMO_32_CHARS

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_REDIS

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRET_DE_64_CHARS_MINIMO
JWT_REFRESH_SECRET=CAMBIAR_POR_REFRESH_SECRET_DIFERENTE_AL_ANTERIOR

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://app.habilitapro.com

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_CAMBIAR_POR_API_KEY_REAL
EMAIL_FROM=noreply@habilitapro.com

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Dejar vacío en producción para activar todos los limitadores
DISABLE_RATE_LIMIT=

# ── Cifrado ────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_DE_CIFRADO_64_CHARS

# Cifrado AES-256 de payloads de eventos en reposo (OBLIGATORIO en producción — Ley 1581)
ENCRYPT_EVENT_PAYLOADS=true
